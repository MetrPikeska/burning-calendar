{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/data/v1/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        }
      ]
    }
  ],
  "functions": {
    "api/mcp.ts": {
      "includeFiles": "public/data/**",
      "maxDuration": 10
    },
    "api/recent.ts": {
      "includeFiles": "public/data/**",
      "maxDuration": 10
    }
  }
}
