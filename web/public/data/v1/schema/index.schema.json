{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Burning calendar country index (data/v1/{country}/index.json)",
  "description": "One file per country: header plus one entry per region with climatology and validation summary. Field meanings: docs/wiki/data-contract.md.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "country",
    "country_name",
    "period",
    "units",
    "fixture",
    "method_version",
    "regions",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "country": {
      "enum": [
        "GR",
        "AR"
      ]
    },
    "country_name": {
      "type": "string"
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/ym"
        },
        "end": {
          "$ref": "#/$defs/ym"
        }
      }
    },
    "units": {
      "type": "string"
    },
    "fixture": {
      "type": "boolean"
    },
    "method_version": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "source": {
      "type": "object",
      "description": "Provenance: FIRMS product, versions, download dates, filters, boundaries, area CRS",
      "required": [
        "firms",
        "filters",
        "boundaries"
      ],
      "properties": {
        "firms": {
          "type": "object",
          "required": [
            "product",
            "url_pattern",
            "modis",
            "viirs",
            "downloaded"
          ]
        },
        "filters": {
          "type": "object"
        },
        "boundaries": {
          "type": "object",
          "required": [
            "name",
            "url"
          ]
        },
        "area_crs": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "ym": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "month_or_null": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 12
    },
    "climatology": {
      "type": "object",
      "required": [
        "peak_month",
        "onset",
        "end",
        "season_length",
        "season_start_month",
        "bimodal"
      ],
      "properties": {
        "peak_month": {
          "$ref": "#/$defs/month_or_null",
          "description": "Calendar month with the highest mean count"
        },
        "onset": {
          "$ref": "#/$defs/month_or_null",
          "description": "Month the cumulative season count passes 10 %"
        },
        "end": {
          "$ref": "#/$defs/month_or_null",
          "description": "Month the cumulative season count passes 90 %"
        },
        "season_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 12,
          "description": "Months from onset to end, inclusive"
        },
        "season_start_month": {
          "$ref": "#/$defs/month",
          "description": "Climatological minimum month of the region's MODIS series; the season year starts here"
        },
        "bimodal": {
          "type": "boolean"
        }
      }
    },
    "entry": {
      "allOf": [
        {
          "$ref": "#/$defs/climatology"
        }
      ],
      "type": "object",
      "required": [
        "id",
        "name",
        "level",
        "parent",
        "mode",
        "annual_mean",
        "annual_mean_of",
        "loyo_mdape_pct",
        "peak_hit_rate",
        "peak_hit_rate_raw",
        "area_km2",
        "density_per_1000km2"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Country code, NUTS code (Greece) or IGN in1 (Argentina); equals the id in regions.geojson"
        },
        "name": {
          "type": "string"
        },
        "level": {
          "enum": [
            "country",
            "nuts2",
            "nuts3",
            "province",
            "department"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "harmonized",
            "relative"
          ],
          "description": "relative: harm is null, metrics come from MODIS alone; do not compare absolute counts with harmonized regions"
        },
        "annual_mean": {
          "type": "number",
          "description": "Mean season-year total"
        },
        "annual_mean_of": {
          "enum": [
            "harm",
            "modis"
          ]
        },
        "loyo_mdape_pct": {
          "type": [
            "number",
            "null"
          ],
          "description": "Leave-one-year-out median absolute error of annual totals, 2012-2019"
        },
        "peak_hit_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "peak_hit_rate_raw": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "area_km2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Region area in km2 from the assignment polygons in EPSG:6933 (equal-area); Argentina 94 includes the Malvinas"
        },
        "density_per_1000km2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "annual_mean per 1000 km2 per year, on the same series as annual_mean_of; compare only across harmonized regions"
        }
      }
    }
  }
}
