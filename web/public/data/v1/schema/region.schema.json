{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Burning calendar region detail (data/v1/{country}/regions/{id}.json)",
  "description": "Monthly series Nov 2000 to Dec 2025, per-season-year metrics, fitted factors, uncertainty band and validation for one region. Field meanings: docs/wiki/data-contract.md.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "units",
    "id",
    "name",
    "level",
    "parent",
    "mode",
    "summary",
    "months",
    "years",
    "factors",
    "band",
    "validation",
    "area_km2"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "units": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "level": {
      "enum": [
        "country",
        "nuts2",
        "nuts3",
        "province",
        "department"
      ]
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "enum": [
        "harmonized",
        "relative"
      ]
    },
    "summary": {
      "$ref": "index.schema.json#/$defs/climatology"
    },
    "months": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/month_record"
      }
    },
    "years": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/season_year"
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/factor"
      }
    },
    "band": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "month",
          "q_lo",
          "q_hi"
        ],
        "properties": {
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "q_lo": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "q_hi": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "area_km2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "context": {
      "type": "object",
      "description": "Optional context factors (weather, drought, land cover). Context for the calendar, not a prediction",
      "required": ["available", "landcover", "sources"],
      "properties": {
        "available": { "type": "boolean" },
        "landcover": {
          "type": ["object", "null"],
          "required": ["cropland_pct", "tree_pct", "shrub_grass_pct", "other_pct", "source"],
          "properties": {
            "cropland_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "tree_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "shrub_grass_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "other_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "source": { "type": "string" }
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["name", "url"],
            "properties": { "name": { "type": "string" }, "url": { "type": "string" } }
          }
        }
      }
    }
  },
  "$defs": {
    "count_or_null": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "month_or_null": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 12
    },
    "month_record": {
      "type": "object",
      "required": [
        "ym",
        "modis",
        "viirs",
        "harm",
        "harm_lo",
        "harm_hi",
        "src",
        "fit_level",
        "anom_pct",
        "anom",
        "outage_days",
        "outage",
        "baseline_median",
        "baseline_p90",
        "baseline_years",
        "days_modis",
        "days_viirs"
      ],
      "properties": {
        "ym": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "modis": {
          "type": "integer",
          "minimum": 0,
          "description": "Terra + Aqua detections after filters"
        },
        "viirs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "S-NPP detections, null before 2012"
        },
        "harm": {
          "$ref": "#/$defs/count_or_null",
          "description": "VIIRS-equivalent count; equals viirs when src is observed; null in relative mode"
        },
        "harm_lo": {
          "$ref": "#/$defs/count_or_null",
          "description": "10th percentile band for back-cast months"
        },
        "harm_hi": {
          "$ref": "#/$defs/count_or_null",
          "description": "90th percentile band for back-cast months"
        },
        "src": {
          "enum": [
            "observed",
            "backcast",
            "backcast_terra"
          ]
        },
        "fit_level": {
          "enum": [
            "region_month_dn",
            "region_season_dn",
            "region_dn",
            "national_dn",
            null
          ]
        },
        "anom_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "Percentile rank among the same month of the preceding 10 years"
        },
        "anom": {
          "type": "boolean",
          "description": "Above the baseline 90th percentile"
        },
        "outage_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "outage": {
          "type": "boolean",
          "description": "outage_days >= 3"
        },
        "baseline_median": {
          "$ref": "#/$defs/count_or_null",
          "description": "Median of the same calendar month over the baseline years, on the anomaly series (harm in harmonized mode, modis in relative mode)"
        },
        "baseline_p90": {
          "$ref": "#/$defs/count_or_null",
          "description": "90th percentile of the same baseline; anom is true above it"
        },
        "baseline_years": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{4}( without [0-9]{4})?$",
          "description": "Baseline window: the preceding 10 years, or 2002-2011 without the target year for years before 2012"
        },
        "days_modis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31,
          "description": "Days of the month with at least one MODIS detection after filters (acq_date, UTC)"
        },
        "days_viirs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 31,
          "description": "Days of the month with at least one VIIRS detection after filters; null before 2012"
        },
        "fwi": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Optional context. Mean over the month of the daily Fire Weather Index (CEMS, ERA5-based), averaged over the region's grid cells"
        },
        "fwi_pct": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "Optional context. Percentile of fwi among the same calendar month over all years; null with fewer than 10 values"
        },
        "fwi_level": {
          "enum": ["normal", "elevated", "critical", null],
          "description": "Optional context. fwi_pct below 75 normal, 75 to under 90 elevated, 90 and above critical"
        },
        "spei3": {
          "type": ["number", "null"],
          "description": "Optional context. SPEI-3 (SPEIbase), averaged over the region's grid cells"
        },
        "spei6": {
          "type": ["number", "null"],
          "description": "Optional context. SPEI-6 (SPEIbase), averaged over the region's grid cells"
        },
        "spei3_level": {
          "enum": ["dry", "normal", "wet", null],
          "description": "Optional context. dry at or below -1, wet at or above 1"
        },
        "spei6_level": {
          "enum": ["dry", "normal", "wet", null],
          "description": "Optional context. dry at or below -1, wet at or above 1"
        }
      }
    },
    "season_year": {
      "type": "object",
      "required": [
        "season_year",
        "onset",
        "end",
        "season_length",
        "peak_month",
        "total"
      ],
      "properties": {
        "season_year": {
          "type": "integer",
          "description": "Calendar year holding most of the season's months"
        },
        "onset": {
          "$ref": "#/$defs/month_or_null"
        },
        "end": {
          "$ref": "#/$defs/month_or_null"
        },
        "season_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 12
        },
        "peak_month": {
          "$ref": "#/$defs/month_or_null"
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "factor": {
      "type": "object",
      "required": [
        "month",
        "dn",
        "f",
        "level",
        "den_total",
        "kind",
        "window"
      ],
      "properties": {
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "dn": {
          "enum": [
            "D",
            "N"
          ]
        },
        "f": {
          "type": [
            "number",
            "null"
          ]
        },
        "level": {
          "enum": [
            "region_month_dn",
            "region_season_dn",
            "region_dn",
            "national_dn",
            null
          ]
        },
        "den_total": {
          "type": [
            "number",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "viirs_over_modis",
            "modis_over_terra"
          ]
        },
        "window": {
          "type": "string"
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "loyo",
        "time_split",
        "fit_window_gap_pct",
        "ratio_trend",
        "mode",
        "mode_reasons"
      ],
      "properties": {
        "loyo": {
          "type": "object",
          "required": [
            "years",
            "annual_mdape_pct",
            "annual_err_pct",
            "monthly",
            "season"
          ],
          "properties": {
            "years": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "annual_mdape_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "annual_err_pct": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "monthly": {
              "$ref": "#/$defs/monthly_scores"
            },
            "season": {
              "type": "object"
            }
          }
        },
        "time_split": {
          "type": "object",
          "required": [
            "fit",
            "test",
            "annual_err_pct",
            "annual_mdape_pct",
            "monthly"
          ],
          "properties": {
            "fit": {
              "type": "string"
            },
            "test": {
              "type": "string"
            },
            "annual_err_pct": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "annual_mdape_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "monthly": {
              "$ref": "#/$defs/monthly_scores"
            }
          }
        },
        "fit_window_gap_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "ratio_trend": {
          "type": "object"
        },
        "mode": {
          "enum": [
            "harmonized",
            "relative"
          ]
        },
        "mode_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "monthly_scores": {
      "type": "object",
      "properties": {
        "bias_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "r": {
          "type": [
            "number",
            "null"
          ]
        },
        "rmse_log1p": {
          "type": [
            "number",
            "null"
          ]
        },
        "n_months": {
          "type": "integer"
        }
      }
    }
  }
}
